---
/** Small drawn headers for project cards that have no screenshot yet. Decorative. */
interface Props { kind: 'bracket' | 'sheet' }
const { kind } = Astro.props;
const a = '#1f4fd8', m = '#a9c0ff', l = '#dbe5ff';
---
<svg viewBox="0 0 320 180" class="ill" aria-hidden="true">
  <rect width="320" height="180" fill="#f1f5ff" />
  {kind === 'bracket' && (
    <g fill="none" stroke={m} stroke-width="2">
      {[0, 1, 2, 3].map((i) => <rect x="28" y={22 + i * 36} width="70" height="22" rx="5" fill="#fff" />)}
      {[0, 1].map((i) => <rect x="128" y={40 + i * 72} width="70" height="22" rx="5" fill="#fff" />)}
      <rect x="226" y="76" width="70" height="22" rx="5" fill={a} stroke={a} />
      <path d="M98 33H113V69M98 69H113M113 51H128M98 105H113V141M98 141H113M113 123H128M198 51H212V123M198 123H212M212 87H226" />
    </g>
  )}
  {kind === 'sheet' && (
    <g>
      <rect x="24" y="20" width="272" height="140" rx="8" fill="#fff" stroke={m} stroke-width="2" />
      <rect x="24" y="20" width="272" height="24" rx="8" fill={l} />
      {[0, 1, 2, 3, 4].map((r) => (
        <g>
          <line x1="24" x2="296" y1={44 + r * 23} y2={44 + r * 23} stroke={l} stroke-width="2" />
          <rect x="36" y={52 + r * 23} width={40 + ((r * 37) % 50)} height="7" rx="3" fill={m} />
          <rect x="150" y={52 + r * 23} width="48" height="7" rx="3" fill={r === 2 ? a : m} />
          <rect x="228" y={52 + r * 23} width="52" height="7" rx="3" fill={r === 2 ? a : l} />
        </g>
      ))}
      <line x1="138" x2="138" y1="20" y2="160" stroke={l} stroke-width="2" />
      <line x1="216" x2="216" y1="20" y2="160" stroke={l} stroke-width="2" />
    </g>
  )}
</svg>
<style>
  .ill { display: block; width: 100%; height: auto; }
</style>
