---
/**
 * Hero visual: a grid of tiles driven by a slow sine field (a quiet nod to Chromatic Fragments).
 * The pointer leaves a glowing trail, a click sends a ripple. Plain canvas, no library.
 * Pauses off-screen; with reduced motion it draws one still frame.
 */
---
<figure class="hero-canvas" aria-hidden="true">
  <canvas data-hero-canvas></canvas>
  <figcaption class="mono">generative · hover or tap to disturb</figcaption>
</figure>

<script>
  type Ripple = { x: number; y: number; t: number };

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return () => {};
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // light → accent → deep
    const ramp = ['#f1f5ff', '#dbe5ff', '#a9c0ff', '#5a82f0', '#1f4fd8', '#13319a'];
    const COLS = 22;
    let rows = 16, size = 10, gap = 2, energy = new Float32Array(COLS * rows);
    let px = -1e3, py = -1e3, raf = 0, visible = true, last = 0;
    const ripples: Ripple[] = [];

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(r.width * dpr);
      canvas.height = Math.round(r.height * dpr);
      size = canvas.width / COLS;
      gap = Math.max(1, size * 0.12);
      rows = Math.ceil(canvas.height / size);
      energy = new Float32Array(COLS * rows);
      if (still) draw(0);
    };

    const local = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return [((e.clientX - r.left) / r.width) * COLS, ((e.clientY - r.top) / r.height) * rows];
    };
    const onMove = (e: PointerEvent) => { [px, py] = local(e); };
    const onLeave = () => { px = py = -1e3; };
    const onDown = (e: PointerEvent) => { const [x, y] = local(e); ripples.push({ x, y, t: performance.now() }); };

    function draw(now: number) {
      const t = now / 1000;
      const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
      last = now;
      ctx!.clearRect(0, 0, canvas.width, canvas.height);
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < COLS; x++) {
          const i = y * COLS + x;
          const d = Math.hypot(x + 0.5 - px, y + 0.5 - py);
          if (d < 3) energy[i] = Math.min(1, energy[i] + (1 - d / 3) * dt * 9);
          energy[i] *= 1 - dt * 1.6;
          let ring = 0;
          for (const r of ripples) {
            const age = (now - r.t) / 1000;
            const dist = Math.hypot(x + 0.5 - r.x, y + 0.5 - r.y);
            ring = Math.max(ring, Math.max(0, 1 - Math.abs(dist - age * 14) / 1.6) * Math.max(0, 1 - age / 1.8));
          }
          const field = Math.sin(x * 0.33 + t * 0.5) * Math.cos(y * 0.41 - t * 0.35) + Math.sin((x + y) * 0.22 + t * 0.25);
          const base = (field + 2) / 4; // 0..1
          const v = Math.min(1, base * 0.62 + energy[i] * 0.7 + ring * 0.8);
          const level = Math.min(ramp.length - 1, Math.floor(v * ramp.length));
          ctx!.fillStyle = ramp[level];
          const s = size - gap;
          ctx!.beginPath();
          ctx!.roundRect(x * size + gap / 2, y * size + gap / 2, s, s, s * 0.18);
          ctx!.fill();
        }
      }
      while (ripples.length && now - ripples[0].t > 1800) ripples.shift();
    }

    const loop = (now: number) => {
      raf = requestAnimationFrame(loop);
      if (visible) draw(now);
    };

    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);
    const io = new IntersectionObserver(([e]) => (visible = e.isIntersecting));
    io.observe(canvas);
    if (!still) {
      canvas.addEventListener('pointermove', onMove);
      canvas.addEventListener('pointerleave', onLeave);
      canvas.addEventListener('pointerdown', onDown);
      raf = requestAnimationFrame(loop);
    }
    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
    };
  }

  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    stop?.();
    const c = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    stop = c ? start(c) : null;
  });
</script>

<style>
  .hero-canvas { margin: 0; width: 100%; display: flex; flex-direction: column; gap: 8px; }
  canvas { width: 100%; aspect-ratio: 22 / 16; border-radius: 16px; background: #f1f5ff; touch-action: manipulation; cursor: crosshair; }
  figcaption { font-size: 12px; color: var(--muted); text-align: right; }
  @media (max-width: 760px) { canvas { aspect-ratio: 22 / 11; } }
</style>
